# Agents run as local `claude -p` sessions with your Claude login (ADR-14); no API key needed.
# Set LIMO_AGENT_BACKEND=api to use the Messages API instead (then ANTHROPIC_API_KEY is required).
# LIMO_AGENT_BACKEND=claude-cli
# LIMO_CLAUDE_BIN=claude
# Default model per agent (JSON); a model set in the UI/API wins.
# LIMO_AGENT_MODELS={"spec":"claude-sonnet-5-5","build":"claude-haiku-5-5","verify":"claude-sonnet-5-5","close":"claude-sonnet-5-5"}
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
GITLAB_TOKEN=
# LIMO_DATA_DIR=.factory
